# PatchLens dashboard environment.
#
# The dashboard never receives either value in the browser: requests go through
# the same-origin proxy at /api/backend/*, which runs on the Next.js server.
PATCHLENS_API_URL=http://127.0.0.1:8000
# Optional. Set this to the backend's API_AUTH_TOKEN when the API enforces auth.
PATCHLENS_API_TOKEN=

# Optional path used only for display in Settings (the FastAPI docs are served by
# the backend, not proxied through the dashboard).
NEXT_PUBLIC_API_DOCS_URL=http://127.0.0.1:8000/docs
