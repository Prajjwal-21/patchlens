# PatchLens configuration example. Copy to .env and edit.
# Generated by `python -m patchlens.cli config --write-env-example` from the
# Settings model, so it cannot drift from the code. Every variable has a
# working default for local development: a fresh checkout runs with an empty
# environment, SQLite, the deterministic mock LLM and hashing embeddings.

# Relative SQLite paths resolve against the process working directory.

ALLOW_LOCAL_TEST_EXECUTION=False

ALLOWED_FILE_EXTENSIONS=.py,.pyi

API_AUTH_TOKEN=
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"

API_DOCS_ENABLED=True

APP_NAME=PatchLens

AUTO_CREATE_SCHEMA=True

CORS_ORIGINS=http://localhost:3000

DATABASE_ECHO=False

DATABASE_URL=sqlite+pysqlite:///./var/patchlens.db

DB_MAX_OVERFLOW=10

DB_POOL_SIZE=5

DB_STATEMENT_TIMEOUT_MS=30000

DEBUG=False

DEMO_MODE_ENABLED=False

DEMO_SEED_PATH=

EMBEDDING_API_KEY=

EMBEDDING_BASE_URL=https://api.openai.com/v1

EMBEDDING_BATCH_SIZE=96

EMBEDDING_DIM=512

EMBEDDING_MODEL=hashing-ngram-v2

EMBEDDING_PROVIDER=hashing

EMBEDDING_TIMEOUT_SECONDS=30.0

ENVIRONMENT=development

EXCLUDED_DIR_NAMES=.git,.hg,.svn,.venv,venv,env,__pycache__,node_modules,.mypy_cache,.pytest_cache,.ruff_cache,.tox,.nox,build,dist,.eggs,site-packages,.idea,.vscode,migrations,vendor,third_party

EXCLUDED_FILE_PATTERNS=*.pyc,*.pyo,*.so,*.dylib,*.dll,*.min.js,*.lock,*.pdf,*.png,*.jpg,*.jpeg,*.gif,*.ico,*.zip,*.tar,*.gz,*.whl,*.pem,*.key,*.p12,*.pfx,*.crt,*.jks,*.keystore,id_rsa*,.env,.env.*,*.env,secrets.*,*credentials*.json

GITHUB_API_BASE_URL=https://api.github.com

GITHUB_APP_CLIENT_ID=

GITHUB_APP_ID=

GITHUB_APP_SLUG=patchlens-dev

GITHUB_COMMENT_SEVERITIES=critical,high

GITHUB_MAX_COMMENTS_PER_REVIEW=10

GITHUB_PRIVATE_KEY=

GITHUB_PUBLISH_ENABLED=False

GITHUB_REQUIRE_VERIFIED_ANCHORS=True

GITHUB_WEBHOOK_SECRET=

INDEX_EMBEDDING_BATCH_SIZE=64

INDEX_MAX_FILE_BYTES=524288

INDEX_MAX_FILES=20000

INDEX_MAX_SYMBOLS=120000

JOB_BACKOFF_BASE_SECONDS=5.0

JOB_BACKOFF_MAX_SECONDS=300.0

JOB_MAX_ATTEMPTS=3

JOB_TIMEOUT_SECONDS=900

LLM_API_KEY=

LLM_BASE_URL=https://api.openai.com/v1

LLM_COST_PER_MTOK_INPUT_USD=0.0

LLM_COST_PER_MTOK_OUTPUT_USD=0.0

LLM_MAX_CONTEXT_CHARS=24000

LLM_MAX_OUTPUT_TOKENS=2048

LLM_MAX_RETRIES=2

LLM_MODEL=gpt-4o-mini

LLM_PROVIDER=mock

LLM_TEMPERATURE=0.0

LLM_TIMEOUT_SECONDS=45.0

LOG_JSON=False

LOG_LEVEL=INFO

MAX_INDEX_SNAPSHOT_BYTES=67108864

MAX_REQUEST_BYTES=4194304

MAX_WEBHOOK_BYTES=2097152

REDIS_URL=

REQUEST_TIMEOUT_SECONDS=60.0

RERANKER=heuristic

RETRIEVAL_BM25_B=0.75

RETRIEVAL_BM25_K1=1.5

RETRIEVAL_CACHE_TTL_SECONDS=300

RETRIEVAL_CANDIDATE_K=30

RETRIEVAL_HYBRID_WEIGHT_BM25=1.0

RETRIEVAL_HYBRID_WEIGHT_SEMANTIC=1.0

RETRIEVAL_MAX_RESULTS_PER_FILE=3

RETRIEVAL_RRF_K=60

RETRIEVAL_STRATEGY=hybrid

RETRIEVAL_TOP_K=5

REVIEW_MAX_FINDINGS=40

REVIEW_MAX_HUNKS=300

SEMANTIC_SCAN_LIMIT=50000

TEST_EXECUTION_CPU_SECONDS=60

TEST_EXECUTION_DOCKER_IMAGE=python:3.11-slim

TEST_EXECUTION_MAX_OUTPUT_BYTES=262144

TEST_EXECUTION_MEMORY_MB=1024

TEST_EXECUTION_MODE=disabled

TEST_EXECUTION_NETWORK_ENABLED=False

TEST_EXECUTION_TIMEOUT_SECONDS=120

TRUST_PROXY_HEADERS=False

WORKER_CONCURRENCY=2

WORKER_ID=

WORKER_LEASE_SECONDS=900

WORKER_POLL_INTERVAL_SECONDS=1.0

